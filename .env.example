# Hotel Growth OS Environment Configuration

# Core Application Secret (Required in production)
# Must be at least 32 bytes (e.g., generate with `openssl rand -hex 32`)
HGO_APP_SECRET=

# Operator Inbox Password (Required for /ops access)
# Must be at least 16 characters (e.g., generate with `openssl rand -hex 24`)
OPS_PASSWORD=

# Production Storage (Optional: Supabase integration)
# When set, the application uses Supabase PostgreSQL instead of the local file ledger.
# Target Supabase Project: https://gvjxjsjwuweecilcqqhb.supabase.co
SUPABASE_URL=https://gvjxjsjwuweecilcqqhb.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Local / Ephemeral Storage (Optional)
# Defaults to .local/lead-ledger.json (or /tmp/lead-ledger.json in serverless/Vercel)
# HGO_LEDGER_PATH=/path/to/custom-lead-ledger.json
